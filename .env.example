PORT=4000
ORIGIN=http://localhost:12312
NODE_ENV=development

#BD postgres
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=


# Circuit breaker (opossum)
CB_TIMEOUT_MS=8000
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT_MS=15000
CB_VOLUME_THRESHOLD=5

# Limpieza de fotos huérfanas (node-cron)
# Formato: minuto hora dia-del-mes mes dia-de-la-semana (0=domingo, 1=lunes... 6=sábado)
# La hora va en formato 24h (0-23), no AM/PM.
#
# --- CADA HORA / CADA MINUTO ---
#   "* * * * *"      -> cada minuto (solo para pruebas, NO dejar así en producción)
#   "*/15 * * * *"   -> cada 15 minutos
#   "0 * * * *"      -> cada hora, en punto (minuto 0 de cada hora)
#   "0 */6 * * *"    -> cada 6 horas (00:00, 06:00, 12:00, 18:00)
#
# --- UNA VEZ AL DÍA ---
#   "0 3 * * *"      -> todos los días, a las 3:00 AM
#   "30 2 * * *"     -> todos los días, a las 2:30 AM
#   "0 12 * * *"     -> todos los días, a mediodía (12:00 PM)
#   "15 23 * * *"    -> todos los días, a las 11:15 PM (23:15)
#
# --- UNA VEZ (O VARIAS) A LA SEMANA ---
#   "0 3 * * 0"      -> una vez por semana, domingo a las 3:00 AM
#   "0 3 * * 1"      -> una vez por semana, lunes a las 3:00 AM
#   "0 3 * * 1,3,5"  -> tres veces por semana: lunes, miércoles y viernes a las 3:00 AM
#   "0 3 * * 1-5"    -> todos los días laborales (lunes a viernes) a las 3:00 AM
#   "0 3 * * 6,0"    -> solo fines de semana (sábado y domingo) a las 3:00 AM
#
# --- UNA VEZ AL MES ---
#   "0 3 1 * *"      -> una vez al mes, el día 1 a las 3:00 AM
#   "0 3 15 * *"     -> una vez al mes, el día 15 a las 3:00 AM
#   "0 3 1,15 * *"   -> dos veces al mes, días 1 y 15 a las 3:00 AM
#   "0 3 28 * *"     -> una vez al mes, el día 28 (evita problemas con meses de 28-31 días)
#
# OJO: node-cron usa la zona horaria del SERVIDOR donde corre el proceso, no una fija.
# Si el server corre en UTC y pones "0 3 * * *" pensando en hora de El Salvador,
# en realidad se ejecutará a las 3:00 AM UTC = 9:00 PM hora de El Salvador (UTC-6).
ORPHAN_PHOTOS_CRON="0 * * * *"

# Edad mínima (en minutos) que debe tener una foto huérfana antes de poder borrarla.
# 60 = 1 hora | 1440 = 1 día | 10080 = 1 semana | 43200 = 1 mes (30 días)
# Si bajas la frecuencia del cron (ej. a 1 vez/mes), considera subir este valor también,
# o podrías estar borrando fotos casi apenas se vuelven huérfanas, sin darle tiempo al usuario.
ORPHAN_PHOTOS_MIN_AGE_MINUTES=1440